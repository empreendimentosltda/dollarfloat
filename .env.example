# ============================================
# HALO LAMP STORE — Variáveis de Ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o arquivo .env real no git.
# ============================================

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DATA_PROVIDER=local

# ---------- JWT (login do painel admin) ----------
JWT_SECRET=

# ---------- Admin (usado apenas no primeiro seed) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
INITIAL_STOCK=0

# ---------- Firebase (Firestore) ----------
# Para testar localmente sem banco externo, mantenha DATA_PROVIDER=local.
# Para usar Firebase em producao, troque para DATA_PROVIDER=firebase e preencha os campos abaixo.
# Gere em: Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# Cole a private_key exatamente como veio no JSON, mantendo os \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUACHAVEAQUI\n-----END PRIVATE KEY-----\n"

# ---------- Gateway de Pagamento ativo ----------
# Valores aceitos: disabled (vendas desligadas), abacatepay
PAYMENT_PROVIDER=disabled

# ---------- AbacatePay API v2 ----------
ABACATEPAY_ENV=sandbox
ABACATEPAY_API_KEY=
ABACATEPAY_PRODUCT_ID=
ABACATEPAY_WEBHOOK_SECRET=

# ---------- Pixels / Analytics de terceiros (opcional, também editável no painel) ----------
META_PIXEL_ID=
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
TIKTOK_PIXEL_ID=

# ---------- Loja ----------
STORE_NAME=Dollar Float
STORE_WHATSAPP=5511999999999
